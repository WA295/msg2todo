# ============ LLM 配置(OpenAI 兼容接口)============
# 示例用的是 DeepSeek,也可以填 OpenAI / Moonshot / 通义千问 / 本地 ollama 等
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# ============ 时区(用于解析"明天/下午3点"等相对时间)============
TZ=Asia/Shanghai

# ============ Web 看板 ============
WEB_HOST=0.0.0.0
WEB_PORT=8080
# 访问令牌(云端部署强烈建议设置):设置后看板/接口需要输入该密码
# WEB_AUTH_TOKEN=改成你的访问密码

# ============ QQ (OneBot v11 反向 WebSocket)============
QQ_ENABLED=true
# 监听地址/端口:在 LLOneBot/NapCat 里配置反向 ws 指向 ws://<本机IP>:3001
ONE_BOT_WS_HOST=0.0.0.0
ONE_BOT_WS_PORT=3001
# 可选:接入令牌,配置后插件端也要填一样的 token
ONE_BOT_ACCESS_TOKEN=
# 是否处理群里所有消息(默认只处理 @机器人 的消息)
QQ_PROCESS_ALL_GROUP=false

# ============ 微信 (wechaty) ============
WECHAT_ENABLED=true
# puppet 可选: wechaty-puppet-wechat4u (免费web协议,可能被风控)
#            padlocal (付费iPad协议,较稳定,需填 token)
WECHAT_PUPPET=wechaty-puppet-wechat4u
WECHAT_PUPPET_TOKEN=
WECHAT_PROCESS_ALL_GROUP=false

# ============ 待办提取 ============
# 关键词预过滤:只处理包含这些词的消息(逗号分隔),留空则私聊/被@的消息都发给 LLM
TODO_KEYWORDS=
# 添加成功后是否回复发送者确认(默认 false 静默;想回复改成 true)
REPLY_CONFIRM=false

# ============ 数据 ============
# DB_PATH=data/todos.db

# ============ iOS 手机推送 (Bark, 可选) ============
# App Store 安装 Bark 后,复制里面的推送链接填到这里,新待办和到期提醒会推送到手机
# BARK_URL=https://api.day.app/你的密钥
# PushDeer 安卓推送(App 里复制 pushkey 填这里,可选)
# PUSHDEER_KEY=PDUxxxxxx
# 到期前提前提醒(分钟),默认 60;设 0 只到点提醒
REMIND_ADVANCE_MINUTES=60
# 群白名单(逗号分隔的群号):白名单内的群所有消息都处理,不受 @ 限制
# QQ_GROUP_WHITELIST=123456789,987654321

# ============ 课表(学生私聊机器人发送课表,每晚提醒第二天课程)============
# 每晚提醒时间(HH:MM),学生也可以自己发「提醒时间 21:30」单独设置
SCHEDULE_NOTIFY_TIME=21:00
# 全局默认开学日期(YYYY-MM-DD,第一周周一,可选);用于单双周/周次判断,
# 学生也可以自己发「开学日期 2026-02-23」单独设置
# SCHEDULE_SEMESTER_START=

# ============ 天气推送(Open-Meteo 免费接口,无需 Key)============
# 默认城市(留空则不启用;学生可发「设置天气 城市」单独设置)
# WEATHER_CITY=沈阳
# 每天推送天气的时间(HH:MM),默认 07:00
# WEATHER_NOTIFY_TIME=07:00

# ============ 其他提醒 ============
# 上课前提前提醒(分钟),默认 10
# CLASS_REMIND_MINUTES=10
# 倒计时每日推送时间,默认 08:00
# COUNTDOWN_NOTIFY_TIME=08:00
# 每周回顾推送时间(周日),默认 22:00
# WEEKLY_REVIEW_TIME=22:00

# ============ Web Push(APP 原生推送,不依赖 QQ)============
# 生成方式: node -e "console.log(require('web-push').generateVAPIDKeys())"
# 配置后,网页/App 里可「开启推送」,提醒直达手机通知中心
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
