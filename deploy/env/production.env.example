# iTodo 生产环境变量清单(模板,不含任何真实密钥)
#
# 用法:
#   cp deploy/env/production.env.example /opt/msg2todo/.env
#   chmod 600 /opt/msg2todo/.env && chown itodo:itodo /opt/msg2todo/.env
#   然后填入真实值 —— 真实 .env 永不进 Git(.gitignore 已屏蔽)
#
# 生成随机密钥:
#   openssl rand -hex 24     # WEB_AUTH_TOKEN / ONE_BOT_ACCESS_TOKEN
#   npx web-push generate-vapid-keys

# ── 基础 ──
TZ=Asia/Shanghai
# 主服务只监听回环,由 Caddy 反代对外(安全组无需开放 8080)
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 管理员令牌(前端"管理员登录"用)。必填!留空 = 所有请求按管理员放行,严禁
WEB_AUTH_TOKEN=

# ── QQ 接入 ──
QQ_ENABLED=true
# OneBot 只监听回环:公网入口走 Caddy 的 /onebot(wss)
ONE_BOT_WS_HOST=127.0.0.1
ONE_BOT_WS_PORT=3001
# 学生个人机器人接入令牌(NapCat 端填一样的值)
ONE_BOT_ACCESS_TOKEN=
QQ_PROCESS_ALL_GROUP=false
# QQ_GROUP_WHITELIST=123456789,987654321

# ── 微信已停用(wechaty web 协议长期不可用)──
WECHAT_ENABLED=false

# ── 待办提取 ──
REPLY_CONFIRM=false
REMIND_ADVANCE_MINUTES=60
TODO_KEYWORDS=

# ── LLM(留空则走内置中文规则;课表图片识别需要 LLM_VISION_MODEL)──
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_VISION_MODEL=
LLM_TIMEOUT_MS=60000

# ── 课表 ──
SCHEDULE_NOTIFY_TIME=21:00
SCHEDULE_SEMESTER_START=
CLASS_REMIND_MINUTES=10

# ── 天气(Open-Meteo,免费无需 Key)──
WEATHER_CITY=沈阳
WEATHER_NOTIFY_TIME=07:00

# ── 其他定时 ──
COUNTDOWN_NOTIFY_TIME=08:00
WEEKLY_REVIEW_TIME=22:00

# ── 推送 ──
# Bark iOS:https://api.day.app/<你的key>
BARK_URL=
# PushDeer 安卓 pushkey
PUSHDEER_KEY=
# Web Push(需 HTTPS 才能生效)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── 备份(被 msg2todo-backup.service 读取)──
BACKUP_KEEP=14
# 异地备份(可选):每周用 rclone 同步一份到远端
# BACKUP_REMOTE=rclone-remote:itodo-backups
